# =====================================================================
#  Variables d'environnement — à définir dans Vercel (Settings > Env)
#  NE JAMAIS committer le vrai .env. Ce fichier .env.example sert de modèle.
# =====================================================================

# URL CalDAV du calendrier PARTAGÉ Nextcloud.
# Format typique :
#   https://VOTRE-NEXTCLOUD.tld/remote.php/dav/calendars/UTILISATEUR/NOM-DU-CALENDRIER/
# Pour la trouver : Nextcloud > Agenda > ... à côté du calendrier > Lien / Copier le lien CalDAV.
CALDAV_URL=https://cloud.exemple.fr/remote.php/dav/calendars/jean/agenda-partage/

# Nom d'utilisateur Nextcloud propriétaire (ou ayant accès au) calendrier.
CALDAV_USERNAME=jean

# MOT DE PASSE D'APPLICATION Nextcloud (PAS le mot de passe principal !).
# Nextcloud > Paramètres > Sécurité > "Créer un nouveau mot de passe d'application".
# Avantage : révocable à tout moment, et fonctionne même avec la 2FA activée.
CALDAV_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# --- Optionnel ---

# Durée du cache serveur en secondes (défaut 300 = 5 min).
CACHE_TTL_SECONDS=300

# Fenêtre temporelle récupérée (en jours).
RANGE_PAST_DAYS=30
RANGE_FUTURE_DAYS=365

# Origine autorisée pour le CORS si le front est hébergé sur un AUTRE domaine.
# Laisse "*" si front + API sont sur le même projet Vercel.
# Sinon mets l'URL exacte du front, ex : https://mon-agenda.github.io
ALLOWED_ORIGIN=*
